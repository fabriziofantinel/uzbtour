    "db:link-neon-user": "node --env-file=.env.local scripts/link-neon-auth-user.mjs",
    "db:seed:demo": "node --env-file=.env.local scripts/seed-platform-demo.mjs",
    "aws:validate": "sam validate --template-file infra/aws/template.yaml --lint",
    "aws:build": "sam build --template-file infra/aws/template.yaml",
    "smoke:r2": "node scripts/smoke-r2-cors.mjs",
    "aws:deploy": "sam deploy --guided"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.49",
    "@aws-sdk/client-bedrock-runtime": "^3.1116.0",
