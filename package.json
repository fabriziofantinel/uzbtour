    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@smithy/types": "^4.17.2",
    "@vercel/oidc-aws-credentials-provider": "^3.3.5",
    "ai": "^7.0.73",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
