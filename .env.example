DATABASE_URL=
# Endpoint Neon diretto, usato esclusivamente da migrazioni e manutenzione.
DATABASE_DIRECT_URL=
# Cognito e' l'unico provider di credenziali. Neon conserva ruoli e tenant.
# Lo username e' univoco; l'email e' contatto non univoco e recupero password.
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
AWS_AUTH_ROLE_ARN=
SES_INVITATION_SENDER=
# Architettura definitiva asincrona.
PLATFORM_JOB_QUEUE_PROVIDER=sqs
PLATFORM_OBJECT_STORAGE_PROVIDER=r2
PLATFORM_AI_PROVIDER=bedrock

# Cloudflare R2 privato (documenti e, nella fase successiva, foto)
R2_ACCOUNT_ID=
R2_JURISDICTION=eu
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AWS SQS / Lambda / Bedrock
AWS_REGION=eu-central-1
AWS_ROLE_ARN=
AWS_SQS_IMPORT_QUEUE_URL=
AWS_BEDROCK_TEXT_MODEL=eu.amazon.nova-2-lite-v1:0
AWS_BEDROCK_VISION_MODEL=eu.amazon.nova-2-lite-v1:0
AWS_BEDROCK_MAX_DOCUMENT_BYTES=4500000
AWS_BEDROCK_MAX_OUTPUT_TOKENS=9000

# Fallback opzionale, non usato nella configurazione definitiva.
GEMINI_API_KEY=
GEMINI_PHOTO_MODEL=gemini-3.6-flash
GEMINI_IMPORT_MODEL=gemini-3.6-flash
DATABASE_MIGRATION_URL=
# public durante backfill e dual-read; v3 solo dopo il cutover approvato.
PLATFORM_DATA_MODEL=public
# Web Push PWA. Generare la coppia VAPID senza inserirla nel repository.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:operations@example.com
CRON_SECRET=
